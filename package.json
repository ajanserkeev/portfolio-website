{
  "name": "studio-tower",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:lan": "astro build && astro preview --host",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm budgets && pnpm e2e",
    "fixtures:camera": "tsx scripts/gen-camera-fixtures.ts && biome format --write scene/camera-fixtures.json",
    "budgets": "tsx scripts/check-budgets.ts",
    "art:doctor": "tsx art/scripts/doctor.ts",
    "art:test:py": "tsx art/scripts/py.ts -m pytest art/tests -q",
    "art:test:blender": "tsx art/scripts/test-blender.ts",
    "art:test": "pnpm art:test:py && pnpm art:test:blender",
    "art:screens": "tsx art/scripts/screens.ts",
    "art:faces": "tsx art/scripts/faces.ts"
  },
  "dependencies": {
    "astro": "7.3.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
