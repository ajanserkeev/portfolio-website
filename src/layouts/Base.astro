---
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
  lang: 'ru' | 'en';
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
}
const { lang, title, description, ogType, image } = Astro.props;
---
<!doctype html>
<html lang={lang} data-tier="pending" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3ebdd" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo lang={lang} title={title} description={description} ogType={ogType} image={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/unbounded-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/unbounded-700-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
