---
import type { LevelId } from '../engine/config';

interface Props {
  id: LevelId;
}

const { id } = Astro.props;
const posterSrc = `/posters/${id}.webp`;
---
<div class="static-level" data-static-level={id} aria-hidden="true">
  <img
    src={posterSrc}
    alt=""
    class="static-level__img"
    loading="lazy"
    decoding="async"
    width="1200"
    height="720"
  />
</div>

<style>
  .static-level {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 2rem auto;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid rgb(28 27 34 / 0.08);
    background: var(--color-sand-dark);
    box-shadow: 0 16px 32px -20px rgb(28 27 34 / 0.45);
    display: none;
  }

  html[data-tier='static'] .static-level {
    display: block;
  }

  .static-level__img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .static-level:hover .static-level__img {
    transform: scale(1.015);
  }
</style>
