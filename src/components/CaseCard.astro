---
import type { CollectionEntry } from 'astro:content';
import { dict, type Locale } from '../i18n';

interface Props {
  item: CollectionEntry<'cases-ru'> | CollectionEntry<'cases-en'>;
  locale: Locale;
}

const { item, locale } = Astro.props;
const d = dict(locale);
const c = item.data;
const caseUrl = locale === 'ru' ? `/cases/${item.id}/` : `/en/cases/${item.id}/`;
---
<article class="case-card" data-case-id={item.id}>
  <div class="case-card__top">
    <div class="case-card__meta">
      <span class="case-card__badge">{c.industry}</span>
      <span class="case-card__city">{c.city}</span>
    </div>
    {c.nda && <span class="case-card__nda">{d.cases.ndaBadge}</span>}
  </div>

  <h3 class="case-card__title">
    <a href={caseUrl}>{c.title}</a>
  </h3>

  <p class="case-card__summary">{c.summary}</p>

  <div class="case-card__metrics">
    {c.metrics.map((m) => (
      <div class="case-card__metric">
        <strong class="case-card__metric-val">{m.value}</strong>
        <span class="case-card__metric-lbl">{m.label}</span>
      </div>
    ))}
  </div>

  <div class="case-card__footer">
    <div class="case-card__stack">
      {c.stack.map((tech) => (
        <span class="case-card__tech">{tech}</span>
      ))}
    </div>
    <a href={caseUrl} class="case-card__btn">
      <span>{d.cases.viewCase}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(28, 27, 34, 0.08);
    border-radius: 1rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .case-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(28, 27, 34, 0.08);
  }

  .case-card__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .case-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(28, 27, 34, 0.65);
  }

  .case-card__badge {
    padding: 0.2rem 0.55rem;
    background: var(--color-sand);
    border-radius: 0.375rem;
    font-weight: 600;
  }

  .case-card__nda {
    max-width: 100%;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 90, 31, 0.1);
    color: var(--color-signal);
    border-radius: 0.375rem;
    font-weight: 600;
  }

  .case-card__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.35;
    margin: 0;
  }

  .case-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .case-card__title a:hover {
    color: var(--color-signal);
  }

  .case-card__summary {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgba(28, 27, 34, 0.8);
    margin: 0;
  }

  .case-card__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 0.75rem;
    padding: 0.875rem 0;
    border-top: 1px dashed rgba(28, 27, 34, 0.12);
    border-bottom: 1px dashed rgba(28, 27, 34, 0.12);
  }

  .case-card__metric {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .case-card__metric-val {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-teal);
    line-height: 1.1;
  }

  .case-card__metric-lbl {
    font-size: 0.75rem;
    color: rgba(28, 27, 34, 0.65);
    line-height: 1.25;
  }

  .case-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .case-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .case-card__tech {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    background: rgba(28, 27, 34, 0.05);
    border-radius: 0.25rem;
    color: rgba(28, 27, 34, 0.75);
  }

  .case-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.4rem 0.8rem;
    border-radius: 0.5rem;
    background: rgba(28, 27, 34, 0.05);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .case-card__btn:hover {
    background: var(--color-signal);
    color: #ffffff;
  }
</style>
