---
import { LEVEL_IDS } from '../engine/config';
import { dict, type Locale } from '../i18n';
import Dock from './Dock.astro';
import ElevatorPanel from './ElevatorPanel.astro';
import Hero from './Hero.astro';
import LevelSection from './LevelSection.astro';
import Stage from './Stage.astro';
import TopBar from './TopBar.astro';
import ChatSheet from '../islands/ChatSheet';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const floors = LEVEL_IDS.slice(1);
---
<Stage />
<div class="pins" data-pins data-labels={JSON.stringify(dict(locale).hints)} aria-hidden="true"></div>
<TopBar locale={locale} />
<ElevatorPanel locale={locale} />
<main class="tower">
  <Hero locale={locale} />
  {floors.map((id, i) => <LevelSection id={id} index={i + 1} locale={locale} />)}
</main>
<Dock locale={locale} />
<ChatSheet client:load copy={dict(locale).chat} locale={locale} />
