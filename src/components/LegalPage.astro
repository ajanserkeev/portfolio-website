---
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  lead: string;
  updatedAt: string;
  otherLangHref: string;
}

const { locale, title, lead, updatedAt, otherLangHref } = Astro.props;
const d = dict(locale);
const homeHref = locale === 'ru' ? '/' : '/en/';
---
<div class="legal-page-wrap">
  <header class="legal-header">
    <div class="legal-header__container">
      <a href={homeHref} class="legal-header__back" data-back-to-home>
        <span aria-hidden="true">←</span>
        <span>{d.cases.backToTower}</span>
      </a>

      <div class="legal-header__actions">
        <a
          class="chip"
          href={otherLangHref}
          hreflang={d.lang.hreflang}
          lang={d.lang.hreflang}
        >
          {d.lang.switchTo}
        </a>
      </div>
    </div>
  </header>

  <main class="legal-main">
    <article class="legal-article">
      <header class="legal-hero">
        <span class="legal-hero__date">{updatedAt}</span>
        <h1 class="legal-hero__title">{title}</h1>
        <p class="legal-hero__lead">{lead}</p>
      </header>

      <div class="legal-content prose">
        <slot />
      </div>

      <footer class="legal-footer">
        <a href={homeHref} class="legal-footer__back" data-back-to-home>
          <span aria-hidden="true">←</span>
          <span>{d.cases.backToTower}</span>
        </a>
        <p class="legal-footer__copy">{d.legal.copyright}</p>
      </footer>
    </article>
  </main>
</div>

<style>
  .legal-page-wrap {
    min-height: 100vh;
    background: var(--color-sand);
    color: var(--color-ink);
    padding-bottom: 5rem;
  }

  .legal-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(243, 235, 221, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(28, 27, 34, 0.08);
  }

  .legal-header__container {
    max-width: 860px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .legal-header__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    background: rgba(28, 27, 34, 0.05);
    border-radius: 0.5rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .legal-header__back:hover {
    background: var(--color-signal);
    color: #ffffff;
  }

  .legal-main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }

  .legal-article {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .legal-hero {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(28, 27, 34, 0.1);
    padding-bottom: 1.5rem;
  }

  .legal-hero__date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(28, 27, 34, 0.6);
  }

  .legal-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 0;
    color: var(--color-ink);
  }

  .legal-hero__lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(28, 27, 34, 0.85);
    margin: 0;
  }

  .legal-content {
    background: #ffffff;
    border: 1px solid rgba(28, 27, 34, 0.08);
    border-radius: 1rem;
    padding: 2.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(28, 27, 34, 0.9);
  }

  @media (max-width: 640px) {
    .legal-content {
      padding: 1.5rem;
    }
  }

  .legal-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-ink);
    border-top: 1px solid rgba(28, 27, 34, 0.06);
    padding-top: 1.5rem;
  }

  .legal-content :global(h2:first-child) {
    margin-top: 0;
    border-top: none;
    padding-top: 0;
  }

  .legal-content :global(p) {
    margin: 0 0 1rem;
  }

  .legal-content :global(ul) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }

  .legal-content :global(li) {
    margin-bottom: 0.375rem;
  }

  .legal-content :global(strong) {
    color: var(--color-ink);
  }

  .legal-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-top: 1rem;
  }

  .legal-footer__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: rgba(28, 27, 34, 0.06);
    border-radius: 0.5rem;
    transition: background 0.15s ease;
  }

  .legal-footer__back:hover {
    background: rgba(28, 27, 34, 0.12);
  }

  .legal-footer__copy {
    font-size: 0.8125rem;
    color: rgba(28, 27, 34, 0.6);
    margin: 0;
  }
</style>
